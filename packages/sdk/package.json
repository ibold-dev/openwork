{
  "name": "@openwork/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Typed Solana client for the OpenWork escrow program",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "idl"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:integration": "vitest run tests/lifecycle.integration.test.ts",
    "lint": "tsc --noEmit",
    "test:devnet": "vitest run tests/devnet-smoke.integration.test.ts"
  },
  "dependencies": {
    "@solana/kit": "^8.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
