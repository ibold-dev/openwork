# Web app environment.
#
# Everything prefixed NEXT_PUBLIC_ is inlined into the browser bundle at build
# time. Never put a secret here.

# devnet | localnet | mainnet-beta
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# The settlement mint. On Devnet this is the test mint in docs/deployments.md.
NEXT_PUBLIC_DEFAULT_MINT=ENmQKqTu9FaWJtmwk3nXiNT3GxX6F4k7rZe8t2bqUYT8
NEXT_PUBLIC_DEFAULT_MINT_SYMBOL=tUSDC

# Optional metadata API. The Next.js server proxies /api/proxy/* here.
OPENWORK_API_URL=http://127.0.0.1:8080
