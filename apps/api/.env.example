# OpenWork API — example environment
#
# Copy to `.env` and adjust. Nothing here is a secret in local development; do
# not commit the resulting file.

# ------------------------------------------------------------------ server ---
API_BIND=127.0.0.1:8080
API_PUBLIC_ORIGIN=http://localhost:3000
API_DOMAIN=localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------- chain ---
SOLANA_CLUSTER=devnet
ALLOWED_CLUSTERS=devnet,localnet
PROGRAM_ID=GT6deu8TWzjUzu5grXg4zZiAxPosK7tyoykaLtVeLjR
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_RPC_TIMEOUT_SECONDS=15

# ----------------------------------------------------------------- database ---
DATABASE_URL=postgres://openwork:openwork@127.0.0.1:5432/openwork

# -------------------------------------------------------------- sessions -----
# Seconds. Challenge TTL should stay short; sessions are short-lived too.
SESSION_TTL_SECONDS=3600
CHALLENGE_TTL_SECONDS=300
# Set to 1 when the site is served over HTTPS.
COOKIE_SECURE=1

# ------------------------------------------------------------ rate limits ----
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=40

# -------------------------------------------------------- cross-chain routing -
# mock = deterministic local simulation (Devnet). The UI labels it as simulated.
INTENTS_MODE=mock
ONECLICK_API_KEY=
ONECLICK_BASE_URL=
# Send dry quotes only. The verifier records provider responses without moving funds.
ONECLICK_DRY=true
MOCK_QUOTE_TTL_SECONDS=120

# Chain reconciliation worker.
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_BATCH_SIZE=10
WORKER_SYNC_STALE_SECONDS=30
